{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@rtorcato/repo-tooling/biome"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!**/.next",
      "!**/build",
      "!apps/docs",
      "!src/app/shadcn-tailwind.css",
      "!**/.claude/worktrees",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
