# Copy to .env.local and fill in. Server-side only; never prefix with NEXT_PUBLIC_.

# Optional. Fine-grained GitHub token, read-only: Metadata, Issues, Pull
# requests, Actions and Deployments (read) on the rtorcato/* and infra-zero/*
# repos. Without it the GitHub-backed views show "source down".
GITHUB_TOKEN=

# Buzz relay and a dedicated read-only Buzz identity.
BUZZ_RELAY_URL=wss://relay.example
# 64-char hex private key.
BUZZ_PRIVATE_KEY=
# Optional NIP-OA owner attestation JSON, needed when the identity is not a
# relay member: ["auth","<owner-hex>","<conditions>","<sig>"]
BUZZ_AUTH_TAG=
# Hex pubkey of the agents' owner. Only profiles carrying this owner's valid
# NIP-OA attestation count as agents. Defaults to the owner in BUZZ_AUTH_TAG.
BUZZ_OWNER_PUBKEY=

# Media tab: the public R2 bucket written by media_put.sh. Optional; without
# these the Media tab shows "source down". Use an R2 API token scoped to
# Object Read only on this one bucket.
MEDIA_BASE_URL=https://media.example
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Renamed agents, as JSON of former → current display name. An old
# profile folds into the current name and /agents/<old-name> redirects.
# AGENT_ALIASES={"Fizz":"Prime","Comb":"Shockwave"}
AGENT_ALIASES=

# Optional. Comma list of labels to leave off the Needs-you card. merge-ready
# PRs show there by default; set it to merge-ready if a merge bot handles them.
NEEDS_YOU_EXCLUDE_LABELS=

# "Today" on the Agents and Timeline views follows the server clock.
# TZ=America/Toronto
